# ---------- amoCRM ----------
# Поддомен: mycompany (→ mycompany.amocrm.ru) или полный адрес: mycompany.amocrm.com / mycompany.kommo.com
AMOCRM_DOMAIN=your_subdomain
# Долгосрочный токен: amoCRM → Настройки → Интеграции → ваша интеграция → «Ключи и доступы»
AMOCRM_TOKEN=
AMOCRM_TIMEZONE=Europe/Moscow

# ---------- доступ к MCP ----------
# Обязателен для HTTP. Сгенерировать: openssl rand -hex 32 . Можно несколько через запятую.
MCP_AUTH_TOKEN=
# Публичный адрес сервера (для ссылок на выгрузки xlsx/csv)
PUBLIC_BASE_URL=https://mcp.example.ru
# Домен для автоматического HTTPS (docker compose --profile https)
MCP_DOMAIN=mcp.example.ru

# ---------- защита данных ----------
# Необратимые операции (удаление воронок, этапов, полей, вариантов списков, DELETE через произвольный запрос).
# 0 — запрещены (рекомендуется). Включайте временно и только при необходимости.
MCP_ALLOW_DESTRUCTIVE=0
# Произвольный запрос к API на запись (POST/PATCH). 0 — только чтение (рекомендуется).
MCP_ALLOW_RAW_WRITE=0
# Изменение больше стольких записей за раз требует подтверждения (предпросмотр → confirm_token)
MCP_CONFIRM_THRESHOLD=10
# Максимум записей за один вызов изменения / массового изменения
MCP_MAX_WRITE_ITEMS=500
MCP_MAX_BULK_ITEMS=2000
# Папка журнала изменений (со значениями «до» для отмены). Пусто = ./audit в папке проекта
MCP_AUDIT_DIR=
# Окно защиты от повторного создания (минуты)
MCP_DEDUPE_MINUTES=10

# ---------- ограничения (необязательно) ----------
# 1 — только чтение (все инструменты изменения отключены)
MCP_READ_ONLY=0
# Включить только нужные группы, через запятую (пусто = все):
# reference,admin,leads,contacts,companies,links,tasks,notes,events,unsorted,customers,catalogs,calls,reports,raw,journal
MCP_TOOLSETS=
# Запросов в секунду к amoCRM (лимит amoCRM — 7)
AMOCRM_RPS=6
# Максимум записей в выгрузке файлом
MCP_MAX_FETCH_ITEMS=50000
EXPORT_TTL_HOURS=24
